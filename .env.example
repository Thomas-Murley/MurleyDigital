# Copy this file to .env.local and fill it in before you go live.

# Public site URL, no trailing slash. Used for invite links, Stripe return URLs, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login for the first admin account. Used only when the database file is first created.
# If you leave this blank, a random password is written to data/generated-admin-password.txt.
ADMIN_EMAIL=admin@murleydigital.com
ADMIN_PASSWORD=

# Signs session cookies. Use a long random string in production.
SESSION_SECRET=

# Optional. Protects POST /api/cron/billing so a daily job can record hosting charges.
# Send header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Leave BILLING_MODE unset to use Stripe when STRIPE_SECRET_KEY is present.
# Set to demo to force the rehearsal vault even if a Stripe key exists.
# BILLING_MODE=demo

# Live monthly charges. Use test keys first, then live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint: https://YOUR_DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted
